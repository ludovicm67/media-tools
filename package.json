{
  "name": "media-tools",
  "version": "0.0.0",
  "private": true,
  "description": "Root package to handle all media-tools packages",
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "lint": "oxlint",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "pretest": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "clean": "npm run clean --workspaces --if-present",
    "release": "changeset publish",
    "prepare": "husky",
    "build": "npm run clean && npm run build --workspaces --if-present"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.0",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0"
  },
  "lint-staged": {
    "*.{js,mjs,ts}": [
      "oxfmt",
      "oxlint --fix"
    ]
  }
}
